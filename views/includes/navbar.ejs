<style>
/* Search Button */
.search-btn {
    background-color: #fe424d;
    color: white;
    border-radius: 25px;
    padding: 0.4rem 0.7rem;
    border: none;
}

.search-btn:hover {
    background-color: #d93943;
}

/* Search Bar Box */
.navbar-search {
    border: 1px solid #ddd;
    border-radius: 30px;
    padding: 0.4rem 0.6rem;
    display: flex;
    align-items: center;
    box-shadow: 0 1px 2px rgba(0,0,0,0.08),0 4px 12px rgba(0,0,0,0.05);
}

/* Search Input */
.search-input {
    border: none;
    outline: none;
    padding: 0 0.6rem;
    font-size: 0.9rem;
    width: 220px;
}

/* Center Search Bar */
.search-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
}

/* Mobile Fix */
@media (max-width:768px) {
    .search-center {
        position: static;
        transform: none;
        margin-top: 10px;
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .search-input{
        width:140px;
    }
}
</style>

<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top">
<div class="container-fluid px-md-5 position-relative">

    <!-- Logo -->
    <a class="navbar-brand text-danger" href="/listings">
        <i class="fa fa-compass"></i>
    </a>

    <!-- Toggle Button -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

        <!-- Left Link -->
        <div class="navbar-nav">
            <a class="nav-link" href="/listings">Explore</a>
        </div>

        <!-- Center Search -->
        <div class="search-center">
            <form class="navbar-search" role="search">
                <input class="search-input" type="search" placeholder="Search destinations">
                <button class="search-btn" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
        </div>

        <!-- Right Links -->
        <div class="navbar-nav ms-auto align-items-center">

            <a class="nav-link me-3" href="/listings/new">Airbnb your home</a>

            <% if(!currUser) { %>
                <a class="nav-link fw-bold" href="/signup">Sign up</a>
                <a class="nav-link fw-bold" href="/login">Log in</a>
            <% } %>

            <% if(currUser) { %>
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                        <i class="fa-solid fa-circle-user fs-3"></i>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                        <li>
                            <a class="dropdown-item" href="/logout">Logout</a>
                        </li>
                    </ul>
                </div>
            <% } %>

        </div>

    </div>
</div>
</nav>